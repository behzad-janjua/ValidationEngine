# Google Cloud / Google AI
# Agent 3 does not call Google yet, but this gives the future LLM adapter a stable env key.
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Pingram delivery
PINGRAM_API_KEY=
PINGRAM_EMAIL_TYPE=agent3_product_launch_email
PINGRAM_SMS_TYPE=agent3_product_launch_sms
PINGRAM_SENDER_NAME=
PINGRAM_SENDER_EMAIL=

# Keep true in development. Set false only when you intend to send real messages.
PINGRAM_DRY_RUN=true
