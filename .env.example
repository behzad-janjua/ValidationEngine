# ── Ports ────────────────────────────────────────────────────────────────────
# Agent 1 (idea evaluator):  uvicorn agents.agent1.main:app --port 8001
# Agent 2 (plan & critique): uvicorn agents.agent2.main:app --port 8002
# Agent 3 (market & growth): uvicorn agents.agent3.main:app --port 8000

# ── Google / Gemini (Agents 1 & 3) ───────────────────────────────────────────
# All three env var names are checked in order; set whichever one you use.
GEMINI_API_KEY=
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Agent 1 Gemini model settings (optional — defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# CORS (comma-separated origins, or * to allow all)
CORS_ORIGINS=*

# ── Agent 2 — Ollama ─────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Agent 3 — Pingram delivery ───────────────────────────────────────────────
PINGRAM_API_KEY=
PINGRAM_EMAIL_TYPE=agent3_product_launch_email
PINGRAM_SMS_TYPE=agent3_product_launch_sms
PINGRAM_SENDER_NAME=
PINGRAM_SENDER_EMAIL=

# Keep true in development. Set false only when you intend to send real messages.
PINGRAM_DRY_RUN=true
